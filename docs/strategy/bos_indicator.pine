// © BOS Indicator - Break of Structure Only
//@version=5
indicator('BOS Indicator', overlay = true, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// CONSTANTS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH         = +1
BEARISH         = -1
BULLISH_LEG     = 1
BEARISH_LEG     = 0

STRUCTURE_GROUP = 'BOS Settings'

showSwing       = input(true,       'Show Swing BOS',           group = STRUCTURE_GROUP)
swingLength     = input.int(50,     'Swing Length',             group = STRUCTURE_GROUP, minval = 10)
showInternal    = input(true,       'Show Internal BOS',        group = STRUCTURE_GROUP)
internalLength  = input.int(5,      'Internal Length',          group = STRUCTURE_GROUP, minval = 1, maxval = 20)

bosSwingColor       = input.color(color.new(#2962ff, 0),  'Swing BOS Color',     group = STRUCTURE_GROUP)
bosInternalColor    = input.color(color.new(#2962ff, 50), 'Internal BOS Color',  group = STRUCTURE_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// DATA STRUCTURES
//---------------------------------------------------------------------------------------------------------------------{
// @type UDT representing a pivot point
type pivot
    float currentLevel
    float lastLevel
    bool  crossed
    int   barTime  = time
    int   barIdx   = bar_index

// @type UDT representing trend bias
type trend
    int bias

var pivot swingHigh     = pivot.new(na, na, false)
var pivot swingLow      = pivot.new(na, na, false)
var pivot internalHigh  = pivot.new(na, na, false)
var pivot internalLow   = pivot.new(na, na, false)

var trend swingTrend    = trend.new(0)
var trend internalTrend = trend.new(0)

//---------------------------------------------------------------------------------------------------------------------}
// FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{

// Xác định chân sóng (leg)
leg(int size) =>
    var leg     = 0
    newLegHigh  = high[size] > ta.highest(size)
    newLegLow   = low[size]  < ta.lowest(size)

    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int currentLeg)      => ta.change(currentLeg) != 0
startOfBearishLeg(int currentLeg)  => ta.change(currentLeg) == -1
startOfBullishLeg(int currentLeg)  => ta.change(currentLeg) == +1

// Cập nhật pivot points
updatePivots(int size, bool internal = false) =>
    currentLeg  = leg(size)
    newPivot    = startOfNewLeg(currentLeg)
    pivotLow    = startOfBullishLeg(currentLeg)
    pivotHigh   = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p         = internal ? internalLow : swingLow
            p.lastLevel    := p.currentLevel
            p.currentLevel := low[size]
            p.crossed      := false
            p.barTime      := time[size]
            p.barIdx       := bar_index[size]
        else
            pivot p         = internal ? internalHigh : swingHigh
            p.lastLevel    := p.currentLevel
            p.currentLevel := high[size]
            p.crossed      := false
            p.barTime      := time[size]
            p.barIdx       := bar_index[size]

// Phát hiện BOS (Break of Structure - tiếp tục trend)
detectBos(bool internal = false) =>
    bool isBullishBos = false
    bool isBearishBos = false

    pivot pH    = internal ? internalHigh : swingHigh
    pivot pL    = internal ? internalLow  : swingLow
    trend t     = internal ? internalTrend : swingTrend

    // --- Bullish BOS (tiếp tục trend tăng) ---
    if ta.crossover(close, pH.currentLevel) and not pH.crossed
        pH.crossed := true

        if t.bias == BULLISH or t.bias == 0
            // Trend đã bullish → phá tiếp = BOS
            isBullishBos := true

        t.bias := BULLISH

    // --- Bearish BOS (tiếp tục trend giảm) ---
    if ta.crossunder(close, pL.currentLevel) and not pL.crossed
        pL.crossed := true

        if t.bias == BEARISH or t.bias == 0
            // Trend đã bearish → phá tiếp = BOS
            isBearishBos := true

        t.bias := BEARISH

    [isBullishBos, isBearishBos]

// Vẽ đường và label cho BOS
drawBos(bool isBullish, pivot p, color lineColor, bool internal) =>
    float level     = p.currentLevel
    int   startTime = p.barTime
    string txt      = "BOS"
    lineStyle       = line.style_solid
    lineWidth       = internal ? 1 : 2
    lblSize         = internal ? size.tiny : size.small

    // Vẽ đường ngang từ pivot đến bar hiện tại
    line.new(
         x1     = startTime,
         y1     = level,
         x2     = time,
         y2     = level,
         xloc   = xloc.bar_time,
         color  = lineColor,
         style  = lineStyle,
         width  = lineWidth)

    // Vẽ label
    label.new(
          x          = int(math.avg(startTime, time)),
          y          = level,
         text       = txt,
         xloc       = xloc.bar_time,
         textcolor  = lineColor,
         style      = isBullish ? label.style_label_up : label.style_label_down,
         color      = color.new(color.white, 100),
         size       = lblSize)

//---------------------------------------------------------------------------------------------------------------------}
// EXECUTION
//---------------------------------------------------------------------------------------------------------------------{

// 1) Cập nhật pivot points
updatePivots(swingLength, false)
updatePivots(internalLength, true)

// 2) Phát hiện BOS - Swing
[swBullBos, swBearBos] = detectBos(false)

// 3) Phát hiện BOS - Internal
[intBullBos, intBearBos] = detectBos(true)

// 4) Vẽ Swing BOS
if showSwing
    if swBullBos
        drawBos(true, swingHigh, bosSwingColor, false)
    if swBearBos
        drawBos(false, swingLow, bosSwingColor, false)

// 5) Vẽ Internal BOS
if showInternal
    if intBullBos
        drawBos(true, internalHigh, bosInternalColor, true)
    if intBearBos
        drawBos(false, internalLow, bosInternalColor, true)

//---------------------------------------------------------------------------------------------------------------------}
// PLOT SIGNALS
//---------------------------------------------------------------------------------------------------------------------{
plotshape(swBullBos, 'Swing Bullish BOS', shape.triangleup,   location.belowbar, bosSwingColor, size = size.small)
plotshape(swBearBos, 'Swing Bearish BOS', shape.triangledown, location.abovebar, bosSwingColor, size = size.small)

plotshape(intBullBos, 'Internal Bullish BOS', shape.triangleup,   location.belowbar, bosInternalColor, size = size.tiny)
plotshape(intBearBos, 'Internal Bearish BOS', shape.triangledown, location.abovebar, bosInternalColor, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(swBullBos, 'Swing Bullish BOS', 'Swing Bullish BOS detected')
alertcondition(swBearBos, 'Swing Bearish BOS', 'Swing Bearish BOS detected')
alertcondition(intBullBos, 'Internal Bullish BOS', 'Internal Bullish BOS detected')
alertcondition(intBearBos, 'Internal Bearish BOS', 'Internal Bearish BOS detected')

//---------------------------------------------------------------------------------------------------------------------}
