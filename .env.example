# Exchange: binance, bybit or lighter 
EXCHANGE=binance

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Binance Futures API
BINANCE_API_KEY=
BINANCE_SECRET=

 
# Bybit Futures API DEMO
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_SECRET=

# OKX API - DEMO (Sandbox)
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# OKX API - LIVE (uncomment to use live trading)
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=

# Lighter (DEX). Candle data uses the public API, no key needed.
# perp (default) or spot
LIGHTER_MARKET_TYPE=perp
# true = testnet.zklighter.elliot.ai
LIGHTER_TESTNET=false
# Optional tuning (public limit is 60 requests/min per IP)
# LIGHTER_MIN_REQUEST_INTERVAL=1.0
# LIGHTER_RATE_LIMIT_COOLDOWN=15
# LIGHTER_HTTP_MAX_RETRIES=4
# Trading only (not used yet). API key index must be 4-254.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=

# Token for the web chart trading API (16+ random characters)
WEB_API_TOKEN=change-me-to-a-long-random-string
