# Exchange: binance, bybit or lighter 
EXCHANGE=binance

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Binance Futures API
BINANCE_API_KEY=
BINANCE_SECRET=

 
# Bybit Futures API DEMO
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_SECRET=

# OKX API - DEMO (Sandbox)
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# OKX API - LIVE (uncomment to use live trading)
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=

# Lighter (DEX). Candle data uses the public API, no key needed.
# perp (default) or spot
LIGHTER_MARKET_TYPE=perp
# true = testnet.zklighter.elliot.ai
LIGHTER_TESTNET=false
# Optional tuning (public limit is 60 requests/min per IP)
# LIGHTER_MIN_REQUEST_INTERVAL=1.0
# LIGHTER_RATE_LIMIT_COOLDOWN=15
# LIGHTER_HTTP_MAX_RETRIES=4
# Live tools (src/live/lighter): dashboard, order manager, history, market/limit orders.
# Check the setup with: python -m src.live.lighter.tool.test_connect
# Balance and positions need only the account index (or the wallet address to look it up).
LIGHTER_ACCOUNT_INDEX=
# LIGHTER_WALLET_ADDRESS=0x...
# Orders, open orders and history also need an API key of that account (index 4-254) and the
# signer library: python -m src.live.lighter.signer --download  (or set LIGHTER_SIGNER_PATH)
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=
# cross (default) or isolated
# LIGHTER_MARGIN_MODE=cross
# Market orders: worst fill price = best bid/ask +/- this % (default 0.5)
# LIGHTER_MAX_SLIPPAGE_PCT=0.5
# SL/TP are stop-limit orders with the limit this % past the trigger (default 1.0)
# LIGHTER_TRIGGER_SLIPPAGE_PCT=1.0
# Requests per minute for the live tools, per process (Lighter allows 60/min per IP in total)
# LIGHTER_REQUESTS_PER_MINUTE=40

# Token for the web chart trading API (16+ random characters)
WEB_API_TOKEN=change-me-to-a-long-random-string
