# Copy to llm_service/.env (separate from the trade bot's .env).
# Values here are read by llm_service only; they are not loaded into the bot's os.environ.

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=bot-trade-llm
# OPENROUTER_SITE_URL=

# --- Defaults ---
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openrouter/free
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_MAX_IMAGE_MB=10
